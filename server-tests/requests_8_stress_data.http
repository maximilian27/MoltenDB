### ─── STRESS DATA QUERIES ────────────────────────────────────────────────────
### Query examples against the 100 000-document `stress` collection.
###
### WORKFLOW:
###   1. Start the MoltenDB server (dev mode: --dev-mode, or TLS without it).
###   2. Run §0 (Login) and paste the token into @token below.
###   3. Generate + insert the stress dataset if not already present:
###        cargo run --example generate_stress_data
###        cargo run --example stress_insert
###   4. Run any section below individually.
###
### ─── §0. Login ───────────────────────────────────────────────────────────────
POST http://localhost:1538/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Paste the token from the response here:
@token = eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc4NTk1NjU3Mywic2NvcGVzIjpbIio6KjoqIl0sImp0aSI6ImI5N2RhMDE4LTFjZWQtNDRiNS05NGQ5LTFiYTAzOTA1ZDhkMSJ9.b2LOYyNip2rPKLMC7mQVVhQfEhBt7oTnwX4aH8-tsZE

### ─── §1. Point lookups ───────────────────────────────────────────────────────
### §1a. Fetch the very first document
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": "stress_000001"
}

### §1b. Fetch all
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "order": "desc"
}

### §1c. Fetch the last document
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": "stress_999999"
}

### §1d. Batch fetch — three specific keys at once
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": [
    "stress_000000",
    "stress_025000",
    "stress_075000"
  ]
}

### ─── §2. Field projection ────────────────────────────────────────────────────
### §2a. Select only brand, model, price
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": [
    "stress_000000",
    "stress_000001",
    "stress_000002"
  ],
  "fields": [
    "brand",
    "model",
    "price"
  ]
}

### §2b. Select nested CPU specs
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": [
    "stress_000000",
    "stress_000001",
    "stress_000002"
  ],
  "fields": [
    "brand",
    "model",
    "specs.cpu.brand",
    "specs.cpu.cores",
    "specs.cpu.ghz"
  ]
}

### §2c. Exclude price and tags
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "keys": [
    "stress_000000",
    "stress_000001"
  ],
  "excludedFields": [
    "price",
    "tags"
  ]
}

### ─── §3. WHERE — simple filters ─────────────────────────────────────────────
### §3a. All Apple laptops (brand cycles over 10 brands — ~10 000 results)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": {
      "$eq": "Apple"
    }
  },
  "order": "desc"
}

### §3b. In-stock items under $1 000
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price",
    "in_stock"
  ],
  "where": {
    "in_stock": true,
    "price": {
      "$lt": 1000
    }
  }
}

### §3c. Items priced between $1 500 and $2 500 (inclusive)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
  ],
  "where": {
    "price": {
      "$gte": 1500,
      "$lte": 2500
    }
  }
}

### §3d. Items NOT made by Intel (CPU brand $ne)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "specs.cpu.brand"
  ],
  "where": {
    "specs.cpu.brand": {
      "$ne": "Intel"
    }
  }
}

### §3e. Items with 8+ CPU cores
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "specs.cpu.cores",
    "specs.cpu.ghz"
  ],
  "where": {
    "specs.cpu.cores": {
      "$gte": 8
    }
  }
}

### §3f. Items tagged "gaming"
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "tags",
    "price"
  ],
  "where": {
    "tags": {
      "$ct": "gaming"
    }
  }
}

### §3g. OLED display items
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "display.panel",
    "price"
  ],
  "where": {
    "display.panel": {
      "$eq": "OLED"
    }
  }
}

### §3h. Items with model name containing "Model-0001" ($contains on string)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "model": {
      "$ct": "Model-000"
    }
  },
  "order": "asc"
}

### §3i. Items from Apple, Dell, or Razer ($in)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": {
      "$in": [
        "Apple",
        "Dell",
        "Razer"
      ]
    }
  }
}

### §3j. Exclude Framework and Lenovo ($nin)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": {
      "$nin": [
        "Framework",
        "Lenovo"
      ]
    }
  }
}

### ─── §4. WHERE — logical operators ──────────────────────────────────────────
### §4a. $or — Apple brand OR gaming tag
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "tags"
  ],
  "where": {
    "$or": [
      {
        "brand": {
          "$eq": "Apple"
        }
      },
      {
        "tags": {
          "$ct": "gaming"
        }
      }
    ]
  }
}

### §4b. $and — in-stock AND price under $1 500 AND 8+ cores
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price",
    "specs.cpu.cores"
  ],
  "where": {
    "$and": [
      {
        "in_stock": true
      },
      {
        "price": {
          "$lt": 1500
        }
      },
      {
        "specs.cpu.cores": {
          "$gte": 8
        }
      }
    ]
  }
}

### §4c. $or + top-level — in-stock AND (Apple OR Dell)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "in_stock": true,
    "$or": [
      {
        "brand": {
          "$eq": "Apple"
        }
      },
      {
        "brand": {
          "$eq": "Dell"
        }
      }
    ]
  }
}

### §4d. $or on nested field — Mini-LED or OLED display
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "stress",
  "fields": [
    "brand",
    "model",
    "display.panel",
    "price"
  ],
  "where": {
    "$or": [
      {
        "display.panel": {
          "$eq": "Mini-LED"
        }
      },
      {
        "display.panel": {
          "$eq": "OLED"
        }
      }
    ]
  }
}

