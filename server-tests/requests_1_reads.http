### ─── BASIC READS ─────────────────────────────────────────────────────────────

### §4. Get a single laptop by key
### Returns the document directly (no array wrapper) for single-key lookups.
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "keys": "lp2"
}

### §5. Get all laptops (returns JSON array with _key in each element)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops"
}

### §6. Get a batch of specific laptops by key array
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "keys": [
    "lp1",
    "lp3",
    "lp5"
  ]
}

### ─── FIELD SELECTION (GraphQL-style) ────────────────────────────────────────

### §7. Select only brand, model and price — nothing else sent over the wire
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price",
    "_seq",
    "_modifiedAt"
  ]
}

### §8. Deep nested field selection — only the CPU clock speed buried 3 levels deep
### Response: [ { "_key": "lp1", "specs": { "cpu": { "ghz": 3.5 } } }, ... ]
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.cpu.ghz",
    "specs.cpu.cores"
  ]
}

### §9. excludedFields — return everything except price and the foreign key IDs
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "excludedFields": [
    "price",
    "memory_id",
    "display_id"
  ]
}

### §10. Validation error — fields and excludedFields cannot be used together
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand"
  ],
  "excludedFields": [
    "price"
  ]
}

### ─── WHERE CLAUSE ────────────────────────────────────────────────────────────

### §11. Exact equality — only Apple laptops
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": "Apple"
  }
}

### §12. Numeric range — laptops priced between 1000 and 2000
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "price": {
      "$gt": 1000,
      "$lt": 2000
    }
  }
}

### §13. Nested field WHERE — laptops with 12+ CPU cores
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.cpu"
  ],
  "where": [
    {
      "specs.cpu.cores": {
        "$gte": 12
      }
    }
  ]
}

### §14. Multiple conditions (implicit AND) — Intel laptops under 2kg
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.cpu.brand",
    "specs.weight_kg"
  ],
  "where": {
    "specs.cpu.brand": "Intel",
    "specs.weight_kg": {
      "$lt": 2.0
    }
  }
}

### §15. $ne — all laptops NOT made by Intel
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.cpu.brand"
  ],
  "where": {
    "specs.cpu.brand": {
      "$ne": "Intel"
    }
  }
}

### §16. $contains on a string field — models containing "Pro"
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model"
  ],
  "where": {
    "model": {
      "$contains": "Pro"
    }
  }
}

### §17. $contains on an array field — laptops tagged as "gaming"
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "tags",
    "price"
  ],
  "where": {
    "tags": {
      "$contains": "gaming"
    }
  }
}

### §18. $in — laptops from a specific brand shortlist
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": {
      "$in": [
        "Apple",
        "Dell",
        "Razer"
      ]
    }
  }
}

### §19. $nin — exclude budget/modular brands
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "brand": {
      "$nin": [
        "Framework"
      ]
    }
  }
}

### §20. Combined WHERE — in-stock gaming laptops under $2000
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price",
    "tags"
  ],
  "where": {
    "in_stock": true,
    "tags": {
      "$contains": "gaming"
    },
    "price": {
      "$lt": 2000
    }
  }
}

### ─── SORT ────────────────────────────────────────────────────────────────────

### §21. Sort by price ascending — cheapest first
### Expected: Framework(849), Lenovo(1499), Asus(1699), Dell(1899), Razer(2499), Apple(3499)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "sort": [
    {
      "field": "price",
      "order": "asc"
    }
  ]
}

### §22. Sort by price descending — most expensive first
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "sort": [
    {
      "field": "price",
      "order": "desc"
    }
  ]
}

### §23. Sort by nested field — most CPU cores first
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.cpu.cores",
    "specs.cpu.ghz"
  ],
  "sort": [
    {
      "field": "specs.cpu.cores",
      "order": "desc"
    }
  ]
}

### §24. Multi-field sort — brand asc, then price asc within same brand
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "sort": [
    {
      "field": "brand",
      "order": "asc"
    },
    {
      "field": "price",
      "order": "asc"
    }
  ]
}

### §25. Sort + WHERE — in-stock laptops sorted by weight (lightest first)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "specs.weight_kg",
    "price"
  ],
  "where": {
    "in_stock": true
  },
  "sort": [
    {
      "field": "specs.weight_kg",
      "order": "asc"
    }
  ]
}

### ─── PAGINATION (count + offset) ───────────────────────────────────────────

### §26. count — return only the 3 cheapest laptops
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "sort": [
    {
      "field": "price",
      "order": "asc"
    }
  ],
  "count": 3
}

### §27. offset + count — page 2 of laptops sorted by price (skip 2, take 2)
### Expected: Asus(1699), Dell(1899)
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "sort": [
    {
      "field": "price",
      "order": "asc"
    }
  ],
  "offset": 2,
  "count": 2
}

### §28. offset + count + WHERE — page 2 of in-stock laptops by price
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "in_stock": true
  },
  "sort": [
    {
      "field": "price",
      "order": "asc"
    }
  ],
  "offset": 2,
  "count": 2
}

