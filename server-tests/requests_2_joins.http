### ─── JOINS ───────────────────────────────────────────────────────────────────

### §29. Join laptops → memory — embed full memory spec for each laptop
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "ram": {
        "from": "memory",
        "on": "memory_id"
      }
    }
  ]
}

### §30. Join laptops → display — embed only refresh_hz and panel type
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model"
  ],
  "joins": [
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "refresh_hz",
          "panel",
          "size_inch"
        ]
      }
    }
  ]
}

### §31. Double join — embed both memory and display in one query
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "ram": {
        "from": "memory",
        "on": "memory_id",
        "fields": [
          "capacity_gb",
          "type"
        ]
      }
    },
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "size_inch",
          "refresh_hz",
          "panel"
        ]
      }
    }
  ]
}

### §32. Join + WHERE on main collection — only in-stock laptops with their display info
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "where": {
    "in_stock": true
  },
  "joins": [
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "refresh_hz",
          "panel",
          "hdr"
        ]
      }
    }
  ]
}

### §33. Join + WHERE on joined field — laptops with an OLED or Mini-LED display
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "panel",
          "refresh_hz",
          "hdr"
        ]
      }
    }
  ],
  "where": {
    "screen.panel": {
      "$in": [
        "OLED",
        "Mini-LED"
      ]
    }
  }
}

### §34. Join + WHERE on joined field — laptops with 120Hz+ display
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "refresh_hz",
          "panel"
        ]
      }
    }
  ],
  "where": {
    "screen.refresh_hz": {
      "$gte": 120
    }
  }
}

### §35. Join + WHERE on joined field — laptops with upgradeable RAM
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "ram": {
        "from": "memory",
        "on": "memory_id",
        "fields": [
          "capacity_gb",
          "type",
          "upgradeable"
        ]
      }
    }
  ],
  "where": {
    "ram.upgradeable": true
  }
}

### §36. Join + sort — all laptops sorted by display refresh rate descending
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "laptops",
  "fields": [
    "brand",
    "model",
    "price"
  ],
  "joins": [
    {
      "screen": {
        "from": "display",
        "on": "display_id",
        "fields": [
          "refresh_hz",
          "panel"
        ]
      }
    }
  ],
  "sort": [
    {
      "field": "screen.refresh_hz",
      "order": "desc"
    }
  ]
}

