### --- §0. Login ---
POST http://localhost:1538/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}
### Paste the token from the response here:
@token = eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3ODg1NzU0OCwic2NvcGVzIjpbIio6KjoqIl0sImp0aSI6ImI2NGE1NWI0LTU3ZTAtNDQzNy1hYzQwLTAwNWRiOTRlZTBkMiJ9.4BY0sIyEYKt4CdsQsRhfmbCW-UdW9fiOWURp4scVQFE

### §1. TTL -- register a collection-level TTL via /schema (no JSON schema required)
### The entire "cache" collection will be dropped 60 seconds after the last insert batch.
### _expiresAt is a virtual field -- never stored in documents, computed from the collection TTL.
POST http://localhost:1538/schema
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "cache",
  "ttl": 60
}

### §2. TTL -- combine collection-level TTL with a JSON schema
### The "sessions" collection expires 1800 seconds after the last insert batch.
POST http://localhost:1538/schema
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "sessions",
  "schema": {
    "type": "object",
    "properties": {
      "userId": { "type": "string" },
      "token":  { "type": "string" }
    },
    "required": ["userId", "token"]
  },
  "ttl": 1800
}

### §3. TTL -- insert documents into a TTL collection
### The collection expiry clock resets to now+1800s when this batch commits.
### _expiresAt is returned as a virtual field in every response (ISO 8601 format).
POST http://localhost:1538/set
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "sessions",
  "data": {
    "sess_abc": {
      "userId": "u1",
      "token": "xyz123"
    },
    "sess_def": {
      "userId": "u2",
      "token": "abc456"
    }
  }
}

### §4. TTL -- register TTL inline on /set (shortcut, no separate /schema call needed)
### The collection expiry clock resets to now+30s when this batch commits.
POST http://localhost:1538/set
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "cache",
  "data": {
    "hot_item":  { "value": 42 },
    "warm_item": { "value": 99 }
  },
  "ttl": 30
}

### §5. TTL -- verify _expiresAt is present and returned on read (virtual field)
### Response will include "_expiresAt": "2026-..." computed from the collection TTL map.
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "sessions",
  "keys": "sess_abc"
}

### §6. TTL -- inserting more documents resets the expiry clock from now
### After this insert, the collection expires 1800s from THIS moment, not from §3.
POST http://localhost:1538/set
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "sessions",
  "data": {
    "sess_xyz": {
      "userId": "u3",
      "token": "def789"
    }
  }
}

### §7. TTL -- check that the entire collection is gone after the TTL elapses
### (wait for the TTL to pass, then run this -- expects 404 "No documents found")
POST http://localhost:1538/get
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collection": "cache",
  "keys": ["hot_item", "warm_item"]
}
