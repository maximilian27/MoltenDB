  }
}

### ─── EXTENDS (inline reference embedding at insert time) ────────────────────
### The "extend" key embeds data from another collection directly into the
### stored document at insert time. The referenced document is fetched once
### and stored as a snapshot — no join needed on reads.
### Format: "extend": { "<alias>": "<collection>.<key>", ... }
### The "extend" key is removed from the final stored document.

### §50. Insert lp7 with embedded memory and display via extend
### ram  → fetches mem4 from the memory collection and embeds it
### screen → fetches dsp3 from the display collection and embeds it
### After this insert, lp7 contains the full mem4 and dsp3 documents inline.
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "data": {
    "lp7": {
      "brand": "MSI",
      "model": "Titan GT77",
      "price": 3299,
      "in_stock": true,
      "tags": ["gaming", "desktop-replacement", "windows"],
      "specs": {
        "cpu": { "brand": "Intel", "cores": 16, "ghz": 5.0 },
        "battery_wh": 99,
        "weight_kg": 3.3
      },
      "extends": {
        "ram":    "memory.mem4",
        "screen": "display.dsp3"
      }
    }
  }
}

### §51. Read lp7 back — ram and screen are now full embedded documents, not pointers
### Expected: ram = { capacity_gb: 64, type: "DDR5", ... }, screen = { size_inch: 15.6, ... }
### The "extend" key is gone — it was consumed at insert time.
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "keys": "lp7"
}

### §52. extends with auto-generated key (array format)
### The extend block works identically when data is an array (UUIDv7 keys auto-assigned).
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "data": [
    {
      "brand": "HP",
      "model": "Spectre x360",
      "price": 1599,
      "in_stock": true,
      "extends": {
        "ram": "memory.mem2"
      }
    }
  ]
}

### §53. extends with a missing reference — insert still succeeds, alias simply not added
### "memory.mem99" does not exist — the insert completes without error,
### and the stored document will have brand/model/price but no "ram" field.
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "data": {
    "lp8": {
      "brand": "Lenovo",
      "model": "Legion 5",
      "price": 1199,
      "extend": {
        "ram": "memory.mem99"
      }
    }
  }
}

