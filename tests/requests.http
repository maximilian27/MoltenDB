### ─── LOGICAL OPERATORS ──────────────────────────────────────────────────────

### §58. $or — laptops where brand contains "Apple" OR model contains "XPS"
### Expected: Apple MacBook Pro + Dell XPS 15
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model"],
  "where": {
    "$or": [
      { "brand": { "$ct": "Apple" } },
      { "model": { "$ct": "XPS" } }
    ]
  }
}

### §59. $and — laptops that are in stock AND price under $2000
### Expected: same as implicit AND, but using explicit $and syntax
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": {
    "$and": [
      { "in_stock": true },
      { "price": { "$lt": 2000 } }
    ]
  }
}

### §60. $or combined with top-level condition — in-stock laptops from Apple or Dell
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": {
    "in_stock": true,
    "$or": [
      { "brand": { "$eq": "Apple" } },
      { "brand": { "$eq": "Dell" } }
    ]
  }
}

