### ─── STEP 1: Login ──────────────────────────────────────────────────────────
### Run this first. Copy the token from the response and paste it into the
### @token variable below (or replace the Bearer values in each request).

POST https://localhost:1538/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### ─── STEP 2: Seed Data ───────────────────────────────────────────────────────
### Run §1, §2, §3 in order to populate the three collections used by all
### subsequent examples. The laptops collection references memory and display
### collections via foreign keys — this enables the join examples below.

### §1. Seed the `memory` collection
### Each document describes a RAM module. Laptops reference these via `memory_id`.
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "memory",
  "data": {
    "mem1": { "capacity_gb": 8,  "type": "LPDDR5", "speed_mhz": 4266, "upgradeable": false },
    "mem2": { "capacity_gb": 16, "type": "LPDDR5", "speed_mhz": 4266, "upgradeable": false },
    "mem3": { "capacity_gb": 32, "type": "DDR5",   "speed_mhz": 5600, "upgradeable": true  },
    "mem4": { "capacity_gb": 64, "type": "DDR5",   "speed_mhz": 5600, "upgradeable": true  },
    "mem5": { "capacity_gb": 36, "type": "Unified", "speed_mhz": 6400, "upgradeable": false }
  }
}

### §2. Seed the `display` collection
### Each document describes a screen. Laptops reference these via `display_id`.
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "display",
  "data": {
    "dsp1": { "size_inch": 13.3, "resolution": "2560x1600", "panel": "IPS",  "refresh_hz": 60,  "touchscreen": false, "hdr": false },
    "dsp2": { "size_inch": 14.0, "resolution": "2880x1800", "panel": "OLED", "refresh_hz": 90,  "touchscreen": false, "hdr": true  },
    "dsp3": { "size_inch": 15.6, "resolution": "1920x1080", "panel": "IPS",  "refresh_hz": 144, "touchscreen": false, "hdr": false },
    "dsp4": { "size_inch": 16.2, "resolution": "3456x2234", "panel": "Mini-LED", "refresh_hz": 120, "touchscreen": false, "hdr": true },
    "dsp5": { "size_inch": 14.0, "resolution": "2560x1600", "panel": "IPS",  "refresh_hz": 165, "touchscreen": true,  "hdr": false }
  }
}

### §3. Seed the `laptops` collection
### Each laptop has nested specs AND foreign keys to memory + display collections.
### This single collection is used for all query examples below.
POST https://localhost:1538/set
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "data": {
    "lp1": {
      "brand": "Lenovo",
      "model": "ThinkPad X1 Carbon",
      "price": 1499,
      "in_stock": true,
      "memory_id": "mem2",
      "display_id": "dsp2",
      "tags": ["business", "ultrabook", "lightweight"],
      "specs": {
        "cpu": { "brand": "Intel", "cores": 12, "ghz": 3.5 },
        "battery_wh": 57,
        "weight_kg": 1.12
      }
    },
    "lp2": {
      "brand": "Apple",
      "model": "MacBook Pro 16",
      "price": 3499,
      "in_stock": true,
      "memory_id": "mem5",
      "display_id": "dsp4",
      "tags": ["creative", "professional", "macos"],
      "specs": {
        "cpu": { "brand": "Apple", "cores": 12, "ghz": 4.05 },
        "battery_wh": 100,
        "weight_kg": 2.15
      }
    },
    "lp3": {
      "brand": "Asus",
      "model": "ROG Zephyrus G14",
      "price": 1699,
      "in_stock": true,
      "memory_id": "mem3",
      "display_id": "dsp5",
      "tags": ["gaming", "amd", "portable"],
      "specs": {
        "cpu": { "brand": "AMD", "cores": 8, "ghz": 4.9 },
        "battery_wh": 76,
        "weight_kg": 1.65
      }
    },
    "lp4": {
      "brand": "Dell",
      "model": "XPS 15",
      "price": 1899,
      "in_stock": false,
      "memory_id": "mem3",
      "display_id": "dsp4",
      "tags": ["creative", "windows", "4k"],
      "specs": {
        "cpu": { "brand": "Intel", "cores": 14, "ghz": 3.8 },
        "battery_wh": 86,
        "weight_kg": 1.86
      }
    },
    "lp5": {
      "brand": "Razer",
      "model": "Blade 15",
      "price": 2499,
      "in_stock": true,
      "memory_id": "mem4",
      "display_id": "dsp3",
      "tags": ["gaming", "windows", "rgb"],
      "specs": {
        "cpu": { "brand": "Intel", "cores": 14, "ghz": 4.1 },
        "battery_wh": 80,
        "weight_kg": 2.01
      }
    },
    "lp6": {
      "brand": "Framework",
      "model": "Laptop 13",
      "price": 849,
      "in_stock": true,
      "memory_id": "mem1",
      "display_id": "dsp1",
      "tags": ["modular", "linux", "budget"],
      "specs": {
        "cpu": { "brand": "Intel", "cores": 10, "ghz": 3.3 },
        "battery_wh": 55,
        "weight_kg": 1.3
      }
    }
  }
}

### ─── BASIC READS ─────────────────────────────────────────────────────────────

### §4. Get a single laptop by key
### Returns the document directly (no array wrapper) for single-key lookups.
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "keys": "lp2"
}

### §5. Get all laptops (returns JSON array with _key in each element)
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops"
}

### §6. Get a batch of specific laptops by key array
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "keys": ["lp1", "lp3", "lp5"]
}

### ─── FIELD SELECTION (GraphQL-style) ────────────────────────────────────────

### §7. Select only brand, model and price — nothing else sent over the wire
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"]
}

### §8. Deep nested field selection — only the CPU clock speed buried 3 levels deep
### Response: [ { "_key": "lp1", "specs": { "cpu": { "ghz": 3.5 } } }, ... ]
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.cpu.ghz", "specs.cpu.cores"]
}

### §9. excludedFields — return everything except price and the foreign key IDs
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "excludedFields": ["price", "memory_id", "display_id"]
}

### §10. Validation error — fields and excludedFields cannot be used together
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand"],
  "excludedFields": ["price"]
}

### ─── WHERE CLAUSE ────────────────────────────────────────────────────────────

### §11. Exact equality — only Apple laptops
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": { "brand": "Apple" }
}

### §12. Numeric range — laptops priced between 1000 and 2000
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": {
    "price": { "$gt": 1000, "$lt": 2000 }
  }
}

### §13. Nested field WHERE — laptops with 12+ CPU cores
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.cpu"],
  "where": {
    "specs.cpu.cores": { "$gte": 12 }
  }
}

### §14. Multiple conditions (implicit AND) — Intel laptops under 2kg
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.cpu.brand", "specs.weight_kg"],
  "where": {
    "specs.cpu.brand": "Intel",
    "specs.weight_kg": { "$lt": 2.0 }
  }
}

### §15. $ne — all laptops NOT made by Intel
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.cpu.brand"],
  "where": {
    "specs.cpu.brand": { "$ne": "Intel" }
  }
}

### §16. $contains on a string field — models containing "Pro"
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model"],
  "where": {
    "model": { "$contains": "Pro" }
  }
}

### §17. $contains on an array field — laptops tagged as "gaming"
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "tags", "price"],
  "where": {
    "tags": { "$contains": "gaming" }
  }
}

### §18. $in — laptops from a specific brand shortlist
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": {
    "brand": { "$in": ["Apple", "Dell", "Razer"] }
  }
}

### §19. $nin — exclude budget/modular brands
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": {
    "brand": { "$nin": ["Framework"] }
  }
}

### §20. Combined WHERE — in-stock gaming laptops under $2000
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price", "tags"],
  "where": {
    "in_stock": true,
    "tags": { "$contains": "gaming" },
    "price": { "$lt": 2000 }
  }
}

### ─── SORT ────────────────────────────────────────────────────────────────────

### §21. Sort by price ascending — cheapest first
### Expected: Framework(849), Lenovo(1499), Asus(1699), Dell(1899), Razer(2499), Apple(3499)
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "sort": [{ "field": "price", "order": "asc" }]
}

### §22. Sort by price descending — most expensive first
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "sort": [{ "field": "price", "order": "desc" }]
}

### §23. Sort by nested field — most CPU cores first
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.cpu.cores", "specs.cpu.ghz"],
  "sort": [{ "field": "specs.cpu.cores", "order": "desc" }]
}

### §24. Multi-field sort — brand asc, then price asc within same brand
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "sort": [
    { "field": "brand", "order": "asc" },
    { "field": "price", "order": "asc" }
  ]
}

### §25. Sort + WHERE — in-stock laptops sorted by weight (lightest first)
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "specs.weight_kg", "price"],
  "where": { "in_stock": true },
  "sort": [{ "field": "specs.weight_kg", "order": "asc" }]
}

### ─── PAGINATION (count + offset) ───────────────────────────────────────────

### §26. count — return only the 3 cheapest laptops
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "sort": [{ "field": "price", "order": "asc" }],
  "count": 3
}

### §27. offset + count — page 2 of laptops sorted by price (skip 2, take 2)
### Expected: Asus(1699), Dell(1899)
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "sort": [{ "field": "price", "order": "asc" }],
  "offset": 2,
  "count": 2
}

### §28. offset + count + WHERE — page 2 of in-stock laptops by price
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "where": { "in_stock": true },
  "sort": [{ "field": "price", "order": "asc" }],
  "offset": 2,
  "count": 2
}

### ─── JOINS ───────────────────────────────────────────────────────────────────

### §29. Join laptops → memory — embed full memory spec for each laptop
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "joins": [
    { "ram": { "from": "memory", "on": "memory_id" } }
  ]
}

### §30. Join laptops → display — embed only refresh_hz and panel type
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model"],
  "joins": [
    { "screen": { "from": "display", "on": "display_id", "fields": ["refresh_hz", "panel", "size_inch"] } }
  ]
}

### §31. Double join — embed both memory and display in one query
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
  "collection": "laptops",
  "fields": ["brand", "model", "price"],
  "joins": [
    { "ram":    { "from": "memory",  "on": "memory_id",  "fields": ["capacity_gb", "type"] } },
    { "screen": { "from": "display", "on": "display_id", "fields": ["size_inch", "refresh_hz", "panel"] } }
  ]
}

### §32. Join + WHERE on main collection — only in-stock laptops with their display info
POST https://localhost:1538/get
Content-Type: application/json
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImV4cCI6MTc3NTU0MzQzOH0.JZENW5jZWXMqk4c7Y1RbVh0EMaa9SbC5vCHPlWjB_-Y

{
